# AI 서버 포트 설정
AI_SERVER_PORT=8002

# 메인 PostgreSQL 접근 설정
POSTGRES_HOST=orbis_postgres
POSTGRES_PORT=5432
POSTGRES_USER=orbis
POSTGRES_PASSWORD=orbis
POSTGRES_DB=orbis_db

# AI DB Role 설정 (same PostgreSQL instance, ai schema only)
AI_DB_USER=orbis_ai
AI_DB_PASSWORD=orbis_ai
# PostgreSQL ready 대기 시간 (초)
AI_DB_WAIT_TIMEOUT=180

# AI DB 연결 설정
AI_DATABASE_URL=postgresql://orbis_ai:orbis_ai@orbis_postgres:5432/orbis_db
AI_DATABASE_POOL_MIN_SIZE=1
AI_DATABASE_POOL_MAX_SIZE=10

# Backend -> AI 내부 통신 토큰
AI_INTERNAL_TOKEN=1a9c4c20fb1ecc31433e34aed1689c9a2499f2c3456de3c56670fc6ad0bac7ba

# 임베딩 모델 설정
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-base
AI_EMBEDDING_DIMENSION=768
AI_EMBEDDING_DEVICE=cpu
AI_EMBEDDING_BATCH_SIZE=4
AI_EMBEDDING_MAX_LENGTH=512

# FastAPI 실행 설정
AI_UVICORN_WORKERS=1

